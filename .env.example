# npm start detects this computer's LAN address automatically.
# EXPO_PUBLIC_PICTURE_SEARCH_API_URL=http://192.168.1.25:3001
# Messaging is served by the same local API by default. For a deployed API:
# EXPO_PUBLIC_MESSAGING_API_URL=https://api.example.com/api/v1/messaging
# EXPO_PUBLIC_FUEL_DELIVERY_API_URL=https://api.example.com/api/v1/fuel-deliveries
# npm start also starts the local OBD diagnostics API on port 5000.
# For manual network setup, set this to the computer's Wi-Fi address:
# EXPO_PUBLIC_OBD_API_URL=http://192.168.1.25:5000
