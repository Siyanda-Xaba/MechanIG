{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "fuelDeliveries": {
      "$deliveryId": {
        ".read": "auth != null && data.child('customerId').val() === auth.uid",
        ".write": "auth != null && (!data.exists() ? newData.child('customerId').val() === auth.uid : false)"
      }
    }
  }
}
