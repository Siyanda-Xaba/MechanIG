rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.role == 'superadmin';
    }

    // Users may create/update only their own non-admin profile mirror.
    match /users/{userId} {
      allow create: if isSuperAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        request.resource.data.role in ['customer', 'mechanic'] &&
        request.resource.data.status == 'Active'
      );
      allow read: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
      allow update: if isSuperAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status
      );
      allow delete: if isSuperAdmin();
    }

    // Other platform data is available only to accounts granted the claim by a trusted server.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
