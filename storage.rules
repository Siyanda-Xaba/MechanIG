rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profile pictures can be read by signed-in users; only the owner can upload.
    match /{table}/{uid}/{fileName} {
      allow read: if request.auth != null && (table == 'users' || table == 'mechanics');
      allow create, update: if signedInAs(uid)
        && (table == 'users' || table == 'mechanics')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if false;
    }

    // Identity, licence and business verification documents are private.
    match /mechanic_documents/{uid}/{fileName} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png)|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document)');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
